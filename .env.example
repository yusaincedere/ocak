# Local development only (the server reads this file automatically).
# Production config lives in deploy/.env, generated by deploy/setup.sh.

# Optional: require this code to START a call (joining never needs it).
# CREATE_CODE=wolfpack

# Optional: open /admin with this key to see every room, join any room without its
# password, and mute or remove people. At least 16 characters in production.
# ADMIN_KEY=change-me-to-something-long

# `livekit-server --dev` uses these:
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Docker media address: use your computer's LAN IPv4 for Firefox.
# `npm run docker:up` detects and saves it automatically.
# LIVEKIT_NODE_IP=192.168.1.100
